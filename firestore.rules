rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function coachUids() {
      return [
        'v8TKT4Pmv3Sf4mMMR9aQcJEwgdA2',
        'eQpPtTto5IXmooFieqx97qkGFqg2',
        'eQpPtTto5lXmooFieqx97qkGFqg2',
        'fZAQnoyoDwNHyzIZDyObhkCr1pz1'
      ];
    }

    function isCoach() {
      return request.auth != null
        && request.auth.uid == 'v8TKT4Pmv3Sf4mMMR9aQcJEwgdA2';
    }

    function ownsExisting() {
      return isCoach() && resource.data.coachUid in coachUids();
    }

    function ownsIncoming() {
      return isCoach() && request.resource.data.coachUid in coachUids();
    }

    match /trainees/{traineeId} {
      allow create: if ownsIncoming();
      allow read, delete: if ownsExisting();
      allow update: if ownsExisting() && ownsIncoming();

      match /{sub=**} {
        allow read, write: if isCoach();
      }
    }

    match /exerciseLibraries/{coachId} {
      allow read, delete: if isCoach() && coachId in coachUids();
      allow create, update: if isCoach()
        && coachId in coachUids()
        && request.resource.data.coachUid in coachUids();
    }

    match /publicAccess/{codeId} {
      allow read, delete: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming();
    }

    match /publicPlans/{planId} {
      allow get: if resource.data.get('active', true) == true;
      allow list: if false;

      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming();
      allow delete: if ownsExisting();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}